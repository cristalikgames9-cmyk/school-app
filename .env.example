PORT=3000
NODE_ENV=development

# Только серверные значения. SUPABASE_KEY должен быть service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
COOKIE_SECRET=replace-with-a-long-random-secret

# Календарный месяц статистики считается в этом часовом поясе.
REPORT_TIME_ZONE=America/Costa_Rica

# MailerLite. Если токен не задан, сайт продолжит работать и сохранит
# статистику в users; существующая связка Supabase → MailerLite сможет её забрать.
MAILERLITE_API_TOKEN=
MAILERLITE_GROUP_IDS=

# Ключи пользовательских полей MailerLite (не отображаемые названия).
MAILERLITE_FIELD_STUDENT_NAME=name
# Оставь пустым, пока в MailerLite нет отдельного текстового поля месяца.
MAILERLITE_FIELD_PROGRESS_MONTH=
MAILERLITE_FIELD_LESSONS_COMPLETED=lessons_completed
MAILERLITE_FIELD_TASKS_ANSWERED=tasks_answered
MAILERLITE_FIELD_CORRECT=correct_count
MAILERLITE_FIELD_PARTIAL=partial_count
MAILERLITE_FIELD_INCORRECT=incorrect_count
MAILERLITE_FIELD_SCORE=score_period
